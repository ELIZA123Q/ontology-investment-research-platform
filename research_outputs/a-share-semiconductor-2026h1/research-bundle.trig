  <ir://invest-ontology/runtime#entity/judgment%3Aa-share-semiconductor-2026h1> <ir://invest-ontology/runtime#payload> "{\"bundle_id\": \"research:a-share-semiconductor-2026h1\", \"id\": \"judgment:a-share-semiconductor-2026h1\", \"invalidated_at\": null, \"properties\": {\"conditions\": [\"结论仅覆盖截至2026-09-08已披露信息。\", \"不包含Wind全行业固定样本聚合。\", \"不构成个股买卖或收益率判断。\"], \"confidence\": \"medium\", \"downgrade_condition\": \"制造端ASP/利用率回落，或多数样本库存应收持续快于收入。\", \"evidence_assessment_ref\": \"evidence-assessment:a-share-semiconductor-2026h1\", \"judgment_level\": \"J2\", \"statement\": \"A股半导体行业近半年出现实质性基本面改善，已扩展到收入、扣非利润及部分经营现金流兑现；但改善主要由AI/算力、特色存储、晶圆制造景气和国产替代驱动，传统消费电子仍弱，盈利质量显著分化，不能表述为全行业同步高景气。\", \"upgrade_condition\": \"连续两个季度的固定全样本收入、扣非利润和经营现金流中位数为正，且库存及应收强度不恶化。\"}, \"recorded_at\": \"2026-09-08T02:30:00Z\", \"supersedes\": null, \"type\": \"Judgment\", \"valid_from\": \"2026-09-08T00:00:00+08:00\", \"valid_until\": null}" .
