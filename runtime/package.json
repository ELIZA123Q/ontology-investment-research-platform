{
  "name": "ontology-research-workbench",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "WATCHPACK_POLLING=true CHOKIDAR_USEPOLLING=true next dev --webpack -H 127.0.0.1",
    "dev:singleton": "bash scripts/dev-singleton.sh",
    "build": "next build --webpack",
    "start": "next start -H 127.0.0.1",
    "test": "vitest run",
