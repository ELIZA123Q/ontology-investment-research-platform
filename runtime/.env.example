DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
# 必须与生产模型不同；同一 DeepSeek 账户可使用 flash 做独立审阅。
DEEPSEEK_REVIEW_MODEL=deepseek-v4-flash
# 如果独立审阅模型使用不同账户，在本机 .env.local 填写；不得提交真实密钥。
DEEPSEEK_REVIEW_API_KEY=
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_MAX_TOKENS=32768
# 单个模型请求和整个结构化生成均有硬超时，避免阶段永久停在 running。
DEEPSEEK_REQUEST_TIMEOUT_MS=180000
DEEPSEEK_GENERATION_TIMEOUT_MS=480000
WORKBENCH_DB_PATH=./data/workbench.sqlite
# 可选：将导出放到仓库外，测试/CI 应指向临时目录。
WORKBENCH_EXPORT_ROOT=
