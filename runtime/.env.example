DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# 可选：按阶段路由模型。建议 01 用低成本模型，02/03/04/05 用更强模型；
# 未设置时回退 DEEPSEEK_MODEL。这样成本控制不会把研究主链一起降级。
DEEPSEEK_MODEL_STAGE_01=
DEEPSEEK_MODEL_STAGE_02=deepseek-v4-pro
DEEPSEEK_MODEL_STAGE_03=deepseek-v4-pro
DEEPSEEK_MODEL_STAGE_04=deepseek-v4-pro
DEEPSEEK_MODEL_STAGE_05=deepseek-v4-pro
# 评测/独立审阅用大模型；与生产 flash 形成两个互异 model_id（single_vendor_comparative）。
DEEPSEEK_REVIEW_MODEL=deepseek-v4-pro
# 如果独立审阅模型使用不同账户，在本机 .env.local 填写；不得提交真实密钥。
DEEPSEEK_REVIEW_API_KEY=
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_MAX_TOKENS=32768
# 单轮请求默认 10 分钟、整次结构化生成默认 60 分钟。
# Stage 02/03/04 本身偏慢；超时只用于防止进程永久挂死，不应成为常态失败/降级理由。
DEEPSEEK_REQUEST_TIMEOUT_MS=600000
DEEPSEEK_GENERATION_TIMEOUT_MS=3600000

# 后台任务预算：来源上限按单个研究任务的累计来源数计算；token 为单个阶段任务的累计调用量。
RESEARCH_JOB_MAX_SOURCES=40
RESEARCH_JOB_MAX_TOKENS=1000000
# 只有同时填写金额上限和输入/输出单价时，才启用美元成本估算挡门。
RESEARCH_JOB_MAX_COST_USD=
RESEARCH_INPUT_USD_PER_MILLION_TOKENS=
RESEARCH_OUTPUT_USD_PER_MILLION_TOKENS=
# 独立 worker 的空闲轮询间隔；阶段硬超时沿用对应供应商的 GENERATION_TIMEOUT_MS。
RESEARCH_WORKER_POLL_MS=2000
# worker 每 20 秒续一次默认 60 秒租约；进程崩溃后无需等待阶段硬超时即可回收。
RESEARCH_JOB_LEASE_MS=60000

# Stage03 默认按 JudgmentUnit 分批取证；max batches 是并批上限，不会截断多余单元。
# 新来源/证据会使用批次隔离命名空间，最终确定性重建 summaries / bundles / readiness。
STAGE03_EVIDENCE_UNITS_PER_BATCH=2
STAGE03_EVIDENCE_MAX_BATCHES=4
# 人工「补充取证」的最大自动轮数；默认全量 Stage03 已由上述批次循环控制。
STAGE03_AUTO_SUPPLEMENT_MAX_ROUNDS=3
# Stage05 的研究价值/HQ 失败默认保留为待人工修订，不自动再次付费生成。
# 只有明确接受额外模型费用时才开启。
STAGE05_PAID_AUTO_RETRY=false

# 供应商选择：deepseek（默认）或 openai_compatible（第二供应商：OpenAI / OpenRouter / Qwen 等）
RESEARCH_MODEL_PROVIDER=deepseek
REVIEW_MODEL_PROVIDER=deepseek
# OpenRouter：只填 OPENROUTER_API_KEY 即可（base 默认 https://openrouter.ai/api/v1）
OPENROUTER_API_KEY=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_MODEL_STAGE_01=
OPENAI_COMPAT_MODEL_STAGE_02=
OPENAI_COMPAT_MODEL_STAGE_03=
OPENAI_COMPAT_MODEL_STAGE_04=
OPENAI_COMPAT_MODEL_STAGE_05=
OPENAI_COMPAT_REVIEW_API_KEY=
OPENAI_COMPAT_REVIEW_MODEL=anthropic/claude-3.5-sonnet
OPENAI_COMPAT_DISPLAY_NAME=OpenAI-compatible
OPENAI_COMPAT_MAX_TOKENS=16384
OPENAI_COMPAT_REQUEST_TIMEOUT_MS=600000
OPENAI_COMPAT_GENERATION_TIMEOUT_MS=3600000

# 默认与 README 一致：本机运行库写在 instances/00_本机运行/（不进 Git）。
# 如需改路径可覆盖；相对路径相对 runtime/ 工作目录解析。
# WORKBENCH_DB_PATH=../instances/00_本机运行/workbench.sqlite
# 可选：将导出放到仓库外，测试/CI 应指向临时目录。
WORKBENCH_EXPORT_ROOT=
# 内部审计包包含完整证据与审计链，默认禁止普通下载。
WORKBENCH_ALLOW_AUDIT_DOWNLOAD=false
