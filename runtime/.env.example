DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# 当前统一使用 flash；正式独立审阅需换不同 model_id 或人类审阅。
DEEPSEEK_REVIEW_MODEL=deepseek-v4-flash
# 如果独立审阅模型使用不同账户，在本机 .env.local 填写；不得提交真实密钥。
DEEPSEEK_REVIEW_API_KEY=
DEEPSEEK_REASONING_EFFORT=high
DEEPSEEK_MAX_TOKENS=32768
# 单个模型请求和整个结构化生成均有硬超时，避免阶段永久停在 running。
DEEPSEEK_REQUEST_TIMEOUT_MS=180000
DEEPSEEK_GENERATION_TIMEOUT_MS=480000

# 供应商选择：deepseek（默认）或 openai_compatible（第二供应商：OpenAI / OpenRouter / Qwen 等）
RESEARCH_MODEL_PROVIDER=deepseek
REVIEW_MODEL_PROVIDER=deepseek
# OpenRouter：只填 OPENROUTER_API_KEY 即可（base 默认 https://openrouter.ai/api/v1）
OPENROUTER_API_KEY=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=https://openrouter.ai/api/v1
OPENAI_COMPAT_MODEL=
OPENAI_COMPAT_REVIEW_API_KEY=
OPENAI_COMPAT_REVIEW_MODEL=anthropic/claude-3.5-sonnet
OPENAI_COMPAT_DISPLAY_NAME=OpenAI-compatible
OPENAI_COMPAT_MAX_TOKENS=16384
OPENAI_COMPAT_REQUEST_TIMEOUT_MS=180000
OPENAI_COMPAT_GENERATION_TIMEOUT_MS=480000

# 默认与 README 一致：本机运行库写在 instances/00_本机运行/（不进 Git）。
# 如需改路径可覆盖；相对路径相对 runtime/ 工作目录解析。
# WORKBENCH_DB_PATH=../instances/00_本机运行/workbench.sqlite
# 可选：将导出放到仓库外，测试/CI 应指向临时目录。
WORKBENCH_EXPORT_ROOT=
