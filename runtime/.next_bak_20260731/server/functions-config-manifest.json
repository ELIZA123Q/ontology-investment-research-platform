{
  "version": 1,
  "functions": {
    "/_middleware": {
      "runtime": "nodejs",
      "matchers": [
        {
          "regexp": "^(?:\\/(_next\\/data\\/[^/]{1,}))?\\/api(?:\\/((?:[^\\/#\\?]+?)(?:\\/(?:[^\\/#\\?]+?))*))?(\\.json|\\.rsc|\\.segments\\/.+\\.segment\\.rsc)?[\\/#\\?]?$",
          "originalSource": "/api/:path*"
        }
      ]
    },
    "/api/ontology": {},
    "/api/ontology/[nodeId]/instances": {},
    "/api/ontology/candidates": {},
    "/api/ontology/candidates/[candidateKey]": {},
    "/api/ontology/changes": {},
    "/api/ontology/changes/[requestId]": {},
    "/api/ontology/changes/[requestId]/actions/[actionId]": {},
    "/api/radar": {},
    "/api/radar/events/[id]/start-update": {},
    "/api/radar/refresh": {},
    "/api/runs": {},
    "/api/runs/[id]": {},
    "/api/runs/[id]/actions": {},
    "/api/runs/[id]/actions/[proposalId]/execute": {},
    "/api/runs/[id]/actions/proposals": {},
    "/api/runs/[id]/archive": {},
    "/api/runs/[id]/archive.zip": {},
    "/api/runs/[id]/archive/file": {},
    "/api/runs/[id]/artifacts/[artifactId]": {},
    "/api/runs/[id]/artifacts/[artifactId]/approve": {
      "maxDuration": 800
    },
    "/api/runs/[id]/artifacts/[artifactId]/cancel": {},
    "/api/runs/[id]/artifacts/[artifactId]/file": {},
    "/api/runs/[id]/artifacts/[artifactId]/validate": {
      "maxDuration": 800
    },
    "/api/runs/[id]/baseline": {
      "maxDuration": 800
    },
    "/api/runs/[id]/change-set": {},
    "/api/runs/[id]/continue": {
      "maxDuration": 3600
    },
    "/api/runs/[id]/evaluation": {},
    "/api/runs/[id]/evaluation/recompute-metrics": {},
    "/api/runs/[id]/independent-review": {
      "maxDuration": 800
    },
    "/api/runs/[id]/jobs/[jobId]/cancel": {},
    "/api/runs/[id]/jobs/[jobId]/retry": {
      "maxDuration": 3600
    },
    "/api/runs/[id]/object-set": {},
    "/api/runs/[id]/publish": {},
    "/api/runs/[id]/relations/options": {},
    "/api/runs/[id]/report.md": {},
    "/api/runs/[id]/revise": {
      "maxDuration": 800
    },
    "/api/runs/[id]/sources/acquire": {},
    "/api/runs/[id]/stages/[stage]/generate": {
      "maxDuration": 3600
    },
    "/api/runs/[id]/stages/01/clarify": {
      "maxDuration": 3600
    },
    "/api/runs/[id]/status": {},
    "/api/runs/[id]/work-items": {},
    "/api/runs/[id]/work-items/[itemId]": {},
    "/api/runs/[id]/work-items/batch": {}
  }
}