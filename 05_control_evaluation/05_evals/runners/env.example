# 评测 Harness 环境变量（单供应商 DeepSeek；与 06_runtime/.env.local 共用同一 API Key 即可）
# 复制为 05_control_evaluation/05_evals/runners/.env 或在运行前 export；勿提交真实密钥。

EVAL_PRODUCER_API_KEY=
EVAL_PRODUCER_BASE_URL=https://api.deepseek.com
EVAL_PRODUCER_MODEL=deepseek-v4-flash
EVAL_PRODUCER_API_STYLE=chat_completions

EVAL_JUDGE_A_API_KEY=
EVAL_JUDGE_A_BASE_URL=https://api.deepseek.com
EVAL_JUDGE_A_MODEL=deepseek-v4-flash
EVAL_JUDGE_A_API_STYLE=chat_completions

EVAL_JUDGE_B_API_KEY=
EVAL_JUDGE_B_BASE_URL=https://api.deepseek.com
EVAL_JUDGE_B_MODEL=deepseek-v4-flash
EVAL_JUDGE_B_API_STYLE=chat_completions

EVAL_DOWNSTREAM_A_API_KEY=
EVAL_DOWNSTREAM_A_BASE_URL=https://api.deepseek.com
EVAL_DOWNSTREAM_A_MODEL=deepseek-v4-flash
EVAL_DOWNSTREAM_A_API_STYLE=chat_completions

EVAL_DOWNSTREAM_B_API_KEY=
EVAL_DOWNSTREAM_B_BASE_URL=https://api.deepseek.com
EVAL_DOWNSTREAM_B_MODEL=deepseek-v4-flash
EVAL_DOWNSTREAM_B_API_STYLE=chat_completions
