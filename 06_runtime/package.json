{
  "name": "investment-research-copilot-vnext",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack -H 127.0.0.1 -p 3000",
    "build": "next build --webpack",
    "start": "next start -H 127.0.0.1 -p 3000",
    "start:server": "VNEXT_RUNTIME_MODE=server next start -H 0.0.0.0 -p 3000",
    "start:all": "bash scripts/start-all.sh",
    "worker": "node --import tsx src/worker.ts",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "security:audit": "npm audit --audit-level=high",
    "typecheck": "tsc --noEmit",
    "ontology:validate": "python3 ../05_control_evaluation/04_verifiers/ontology/validate_ontology.py",
    "ontology:sync": "python3 scripts/generate-ontology-catalog.py",
    "ontology:check": "python3 scripts/generate-ontology-catalog.py --check",
    "financial:rules:check": "python3 scripts/generate-financial-model-rules.py --check",
    "model:reasoning:protocol:check": "python3 scripts/generate-bounded-model-reasoning-protocol.py --check",
    "model:egress:rules:check": "python3 scripts/generate-model-data-egress-rules.py --check",
    "signal:evidence:rules:check": "python3 scripts/generate-signal-evidence-admission-rules.py --check",
    "source:document:rules:check": "python3 scripts/generate-source-document-attestation-rules.py --check",
    "evidence:prepare-document": "node --import tsx scripts/prepare-public-document-material.ts",
    "domain:sync": "python3 scripts/generate-domain-catalog.py",
    "domain:check": "python3 scripts/generate-domain-catalog.py --check",
    "evidence:sources:sync": "node --import tsx scripts/generate-evidence-source-catalog.ts",
    "evidence:sources:check": "node --import tsx scripts/generate-evidence-source-catalog.ts --check",
    "audit:cutover": "node --import tsx scripts/audit-cutover.ts",
    "audit:authority": "node --import tsx scripts/audit-runtime-authority.ts",
    "audit:domain": "npm run domain:check && node --import tsx scripts/audit-domain-coverage.ts && npm run audit:authority",
    "eval:gold": "node --import tsx scripts/run-gold-evals.ts",
    "eval:research:fixtures": "node --import tsx scripts/run-research-value-fixtures.ts",
    "eval:live:canary": "node --import tsx scripts/run-live-model-canary.ts",
    "eval:public:evidence:pilot": "node --import tsx scripts/run-public-evidence-pilot.ts",
    "eval:earnings:replay": "node --import tsx scripts/run-earnings-update-replay.ts",
    "eval:earnings:runtime": "node --import tsx scripts/run-public-earnings-runtime-replay.ts",
    "eval:earnings:verify-source": "node --import tsx scripts/verify-public-earnings-replay-source.ts",
    "eval:formal:audit": "node --import tsx scripts/audit-formal-case.ts",
    "eval:formal:candidates": "node --import tsx scripts/audit-formal-case.ts ../05_control_evaluation/05_evals/cases/semiconductor-restraint-2026-08-11/manifest.json --require-evidence-ready",
    "db:check": "node --import tsx scripts/database-maintenance.ts check",
    "db:backup": "node --import tsx scripts/database-maintenance.ts backup",
    "db:restore": "node --import tsx scripts/database-maintenance.ts restore"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "24.10.13",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
