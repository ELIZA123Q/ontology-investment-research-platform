# sqlite file; defaults to vnext/.data/vnext.sqlite
VNEXT_DB_PATH=
# optional repository root override for semantic/history read-only adapters
VNEXT_REPO_ROOT=
# local is deterministic and never invents evidence
VNEXT_PROVIDER=local
# opt-in: model proposes a graph; deterministic compiler remains authoritative
VNEXT_MODEL_PLANNING_ENABLED=false
# opt-in: model drafts eligible report sections after formal Judgment approval;
# deterministic fact/number/reference gates and Composer remain authoritative
VNEXT_MODEL_DRAFTING_ENABLED=false
VNEXT_CONNECTOR_INGEST_TOKEN=replace-with-a-long-random-server-token
VNEXT_CONNECTOR_IDS=web.capture,pdf.capture,financial.mcp.wind
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
VNEXT_INTERNAL_ADMIN_TOKEN=
VNEXT_INTERNAL_UI_ENABLED=false
