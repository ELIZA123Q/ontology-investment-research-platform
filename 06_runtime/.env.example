# local: loopback-only personal workspace; server: authenticated HTTP access.
VNEXT_RUNTIME_MODE=local

# Server mode identities are resolved on the server. Never commit real tokens.
# VNEXT_SERVER_IDENTITIES_JSON=[{"token":"replace-me","tenantId":"tenant-a","userId":"analyst-a","roles":["research_owner"]}]
# VNEXT_ALLOWED_ORIGINS=https://research.example.com
# VNEXT_SERVER_CSRF_TOKEN=replace-me
# VNEXT_SERVER_READS_PER_MINUTE=120
# VNEXT_SERVER_MUTATIONS_PER_MINUTE=30

# Model calls remain opt-in. Licensed/no-egress data is rejected by ModelGateway.
VNEXT_MODEL_PLANNING_ENABLED=false
VNEXT_MODEL_REASONING_ENABLED=false
VNEXT_MODEL_DRAFTING_ENABLED=false

# Public-data, cost-bounded DeepSeek canary. Keep real secrets in .env.local.
# VNEXT_PROVIDER=deepseek
# DEEPSEEK_API_KEY=replace-me
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=your-v4-flash-model-id
# DEEPSEEK_THINKING=disabled
# VNEXT_CANARY_DB_PATH=.data/evals/live-canary.sqlite
